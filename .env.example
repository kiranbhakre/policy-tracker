# Copy to .env, fill in real values, then: chmod 600 .env
#
# Loaded by systemd via EnvironmentFile= in systemd/policy-tracker.service.
# For a manual --interactive or --discover run from a shell, load it
# first:
#   set -a; source .env; set +a

# MQTT broker (the existing Mosquitto broker used by Zigbee2MQTT).
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# One username/password pair per account, matching the value_env
# names used in config.yaml's login_steps.
LG_PENSION_USERNAME=
LG_PENSION_PASSWORD=

EXAMPLE_LIFE_USERNAME=
EXAMPLE_LIFE_PASSWORD=
